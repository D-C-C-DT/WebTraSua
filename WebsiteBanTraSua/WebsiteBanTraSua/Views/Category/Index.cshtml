@model IEnumerable<WebsiteBanTraSua.Models.Category>

<h2>Danh sách Category</h2>

<style>
    th, td {
        padding: 8px; /* Điều chỉnh khoảng trắng theo ý muốn */
    }
</style>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên</th>
            <!-- Các cột khác tùy theo nhu cầu -->
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td> 
                <!-- Các cột khác tùy theo nhu cầu -->
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@category.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@category.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>