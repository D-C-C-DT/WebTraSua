@model IEnumerable<WebsiteBanTraSua.Models.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Website Bán Trà Sữa</h1>

<p>
    <a asp-action="Create"><i class="bi bi-file-earmark-plus-fill display-4"></i></a>
</p>
<p>
    <a asp-action="SortByName"><i class="bi bi-sort-alpha-up display-4"></i></a>
    |
    <a asp-action="SortByPriceAsc"><i class="bi bi-sort-up display-4"></i></a>
    |
    <a asp-action="SortByPriceDesc"><i class="bi bi-sort-up-alt display-4"></i></a>
</p>
<table class="table table-hover --bs-info-border-subtle">
    <thead>
        <tr>
            <th>
                @Html.DisplayName("Tên sản phẩm")
            </th>
            <th>
                @Html.DisplayName("Giá")
            </th>
            <th>
                @Html.DisplayName("Hình ảnh sản phẩm")
            </th>
@*             <th>
                @Html.DisplayName("Loại đồ uống")
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @if (item.ImageUrl != null)
                    {
                        <img src="@item.ImageUrl" width="150px" />
                    }
                </td>
                @*<td>
                    @Html.DisplayFor(modelItem => item.Category.Name)
                </td> *@
                <td>
                    <form asp-controller="ShoppingCart" asp-action="AddToCart" method="post">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <label for="quantity">Số lượng:</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="1" />
                        <button class="btn btn-info" type="submit">Thêm vào giỏ hàng</button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-arrow-bar-up display-3" ></i></a> |
                    <a asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-view-list display-3"></i></a> |
                    <a asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-archive-fill display-3"></i></a>
                </td>
            </tr>

        }
        
   
    </tbody>
</table>
