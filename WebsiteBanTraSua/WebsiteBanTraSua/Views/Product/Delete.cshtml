@model WebsiteBanTraSua.Models.Product

@{
    ViewData["Title"] = "Delete";
}

<h1>DELETE</h1>

<h3>Bạn có chắc chắn muốn xóa sản phẩm này?</h3>
<div>
    @* <h4>Product</h4> *@
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayName("Tên sản phẩm")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Giá")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Hình ảnh sản phẩm")
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.ImageUrl" width="150px" />
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Loại sản phẩm")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Xóa</button> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
