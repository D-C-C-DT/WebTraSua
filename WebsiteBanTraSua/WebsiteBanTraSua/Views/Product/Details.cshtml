@model WebsiteBanTraSua.Models.Product

@{
    ViewData["Title"] = "Details";
}

<h1>Thông tin sản phẩm</h1>

<div>
    @* <h4>Product</h4> *@
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayName("Tên sản phẩm")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Giá")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Hình ảnh sản phẩm")
        </dt>
        <dd class="col-sm-10">
            <img src="@Model.ImageUrl" width="150px" />
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayName("Loại đồ uống")
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>
    </dl>
</div>
<div>
    @* <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |  *@
    <a asp-action="Index">Back to List</a>
</div>
<p>
    <strong>Likes:</strong> @Model.Likes
</p>
<button class="btn btn-primary" id="like-button">Like</button>
</div>
</div>
<div>
    @* <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |  *@
    <a asp-action="Index">Back to List</a>
</div>
@section Scripts {
    <script>
        $("#like-button").click(function () {
            $.ajax({
                type: "POST",
                url: "@Url.Action("Like", "Product")",
                data: { id: @Model.Id },
                success: function () {
                    // Update the likes count in the UI
                    $("#likes-count").text(parseInt($("#likes-count").text()) + 1);
                },
                error: function () {
                    alert("Error while liking the product.");
                }
            });
        });
    </script>
}