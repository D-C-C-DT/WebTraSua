@model IEnumerable<WebsiteBanTraSua.Models.Product>
@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <h1 class="display-4">Danh sách Sản phẩm</h1>
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-lg-3 col-md-6 mb-2">
            <div class="col-12 p-1" style="border:1px solid #008cba; border-radius: 5px;">
                <div class="card">
                        <img src="@product.ImageUrl" class="card-img-top" alt="Product Image">
                    <div class="card-body" style="height: 200px">
                        <div class="pl-1">
                                <p class="card-title h5 text-primary">@product.Name</p>
                                <p class="card-title text-secondary">@product.Price</p>
                        </div>
                        <div class="pl-1">
                                <p>Price: <strike>@product.Price.ToString("0.00")</strike></p>
                        </div>
                    </div>
                </div>
                <div>
                        <a asp-controller="Home" asp-action="Detail" class="btn btn-primary font-control" asp-route-id="@product.Id">Detail</a>
                </div>
            </div>
        </div>
        }
    </div>
</div>
